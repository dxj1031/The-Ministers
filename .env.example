# 复制成 .env。MINISTERS_* 优先于 OPENAI_*，所以不会和你全局的 OPENAI_API_KEY 打架。

# 本地 Ollama（免费，慢）
MINISTERS_BASE_URL=http://127.0.0.1:11434/v1
MINISTERS_API_KEY=ollama
MINISTERS_MODEL=qwen2.5:14b
MINISTERS_TIMEOUT=180

# 或者官方 OpenAI
# MINISTERS_BASE_URL=https://api.openai.com/v1
# MINISTERS_API_KEY=sk-...
# MINISTERS_MODEL=gpt-4o-mini
# MINISTERS_TIMEOUT=30

# 不设就是 <repo>/data/ministers.db
# MINISTERS_DB=

# Hosted personal court access password (different from the model API key).
# Required on Render; optional locally. Use at least 16 characters.
# MINISTERS_ACCESS_KEY=
